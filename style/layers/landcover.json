{
  "$comment": "Ground cover as hand-laid watercolour washes. Keys on the `class` produced by pipeline/classify.py, never on raw OSM tags - so reclassifying is a pipeline change, not a style change.",

  "$comment_structure": "Three passes, the way a tinted plan is built up: a flat base tint, the pigment wash over it (sprite pattern, carries all the mottling and granulation), then a crisp ink edge so every parcel still reads as a drawn shape. The flat base matters - it shows at low zoom before the sprite loads, and behind any class with no wash.",

  "label": "Land cover",
  "legend": [
    { "label": "Turf / lawn", "swatch": "area", "color": "$color.landcover.turf", "casing": "$color.landcover.edge" },
    { "label": "Garden (bed rows)", "swatch": "area", "color": "$color.landcover.garden", "casing": "$color.landcover.edge" },
    { "label": "Woodland (stippled)", "swatch": "area", "color": "$color.landcover.woodland", "casing": "$color.landcover.edge" },
    { "label": "Orchard (ranked)", "swatch": "area", "color": "$color.landcover.orchard", "casing": "$color.landcover.edge" },
    { "label": "Farmland (furrowed)", "swatch": "area", "color": "$color.landcover.farmland", "casing": "$color.landcover.edge" },
    { "label": "Water", "swatch": "area", "color": "$color.landcover.water", "casing": "$color.landcover.water_outline" }
  ],

  "layers": [
    {
      "id": "landcover-base",
      "type": "fill",
      "source": "landcover",
      "paint": {
        "fill-color": [
          "match", ["get", "class"],
          "turf", "$color.landcover.turf",
          "park", "$color.landcover.park",
          "garden", "$color.landcover.garden",
          "woodland", "$color.landcover.woodland",
          "scrub", "$color.landcover.scrub",
          "farmland", "$color.landcover.farmland",
          "orchard", "$color.landcover.orchard",
          "wetland", "$color.landcover.wetland",
          "cemetery", "$color.landcover.cemetery",
          "recreation", "$color.landcover.recreation",
          "built_up", "$color.landcover.built_up",
          "water", "$color.landcover.water",
          "$color.landcover.landcover"
        ],
        "fill-opacity": "$opacity.landcover"
      }
    },
    {
      "$comment": "The pigment. Every class above has a matching wash in pipeline/rules/sprite.json.",
      "id": "landcover-wash",
      "type": "fill",
      "source": "landcover",
      "filter": ["in", ["get", "class"],
        ["literal", ["turf", "park", "garden", "woodland", "scrub", "farmland",
                     "orchard", "wetland", "cemetery", "recreation", "built_up", "water"]]],
      "paint": {
        "fill-pattern": [
          "match", ["get", "class"],
          "turf", "pat-turf",
          "park", "pat-park",
          "garden", "pat-garden",
          "woodland", "pat-woodland",
          "scrub", "pat-scrub",
          "farmland", "pat-farmland",
          "orchard", "pat-orchard",
          "wetland", "pat-wetland",
          "cemetery", "pat-cemetery",
          "recreation", "pat-recreation",
          "built_up", "pat-built_up",
          "water", "pat-water",
          "pat-turf"
        ],
        "fill-opacity": "$opacity.landcover_texture"
      }
    },
    {
      "$comment": "Crisp drawn edge around every parcel - the ink over the wash.",
      "id": "landcover-edge",
      "type": "line",
      "source": "landcover",
      "layout": { "line-join": "round" },
      "paint": {
        "line-color": [
          "match", ["get", "class"],
          "water", "$color.landcover.water_outline",
          "$color.landcover.edge"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.4, 17, 0.9, 20, 2.2],
        "line-opacity": ["match", ["get", "class"], "water", 0.85, 0.5]
      }
    }
  ]
}
